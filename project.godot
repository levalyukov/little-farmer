; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LittleFarmer"
config/version="1.2.0"
run/main_scene="res://levels/menu.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="res://assets/sounds/audio.tres"

[autoload]

GameData="*res://assets/scripts/managers/data.gd"
SoundManager="*res://assets/scripts/managers/sounds.gd"
Settings="*res://assets/scripts/managers/settings.gd"
Utils="*res://assets/scripts/managers/utils.gd"
UIManager="*res://assets/nodes/ui/ui.tscn"
PlayerControl="*res://assets/scripts/managers/player_control.gd"
Letters="*res://assets/scripts/containers/letters.gd"
Blueprints="*res://assets/scripts/containers/blueprints.gd"
Items="*res://assets/scripts/containers/items.gd"
Inventory="*res://assets/scripts/managers/inventory.gd"

[debug]

gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[importer_defaults]

animation_library={
"animation/fps": 60.0
}
texture={
"compress/channel_pack": 0,
"compress/hdr_compression": 1,
"compress/high_quality": false,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false,
"mipmaps/limit": -1,
"process/fix_alpha_border": true,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"process/size_limit": 0,
"roughness/mode": 0,
"roughness/src_normal": ""
}

[internationalization]

locale/translation_remaps={}
locale/translations_pot_files=PackedStringArray("res://levels/menu.tscn", "res://assets/nodes/ui/interactive/options/options.tscn", "res://assets/nodes/ui/interactive/pause/pause.tscn", "res://assets/scripts/ui/interactive/inventory/inventory.gd", "res://assets/scripts/ui/interactive/mail/mail.gd", "res://assets/nodes/ui/interactive/construct/construct_menu.tscn", "res://assets/nodes/ui/hud/elements/tools/destroy_menu/button_destroy.tscn", "res://assets/nodes/ui/hud/elements/tools/destroy_menu/button_trash.tscn", "res://assets/nodes/ui/hud/elements/tools/destroy_menu/button_axe.tscn", "res://assets/nodes/ui/hud/elements/tools/destroy_menu/button_pickaxe.tscn", "res://assets/nodes/ui/hud/elements/tools/button_construction.tscn", "res://assets/nodes/ui/hud/elements/tools/button_farming.tscn", "res://assets/nodes/ui/hud/elements/tools/button_harvesting.tscn", "res://assets/nodes/ui/hud/elements/tools/button_watering.tscn", "res://assets/scripts/construction/buildings/storage.gd", "res://assets/scripts/construction/buildings/house.gd", "res://assets/scripts/construction/buildings/mailbox.gd", "res://assets/scripts/ui/hud/elements/clock.gd", "res://assets/scripts/construction/buildings/stall.gd", "res://assets/scripts/construction/buildings/silo.gd", "res://assets/scripts/construction/buildings/sign.gd", "res://assets/scripts/construction/buildings/well.gd", "res://assets/scripts/construction/buildings/greenhouse.gd", "res://assets/scripts/construction/buildings/public_well.gd", "res://assets/scripts/construction/buildings/sawmill.gd", "res://assets/scripts/construction/buildings/tablet.gd", "res://assets/scripts/construction/buildings/traderHouse.gd", "res://assets/scripts/construction/buildings/carpenter_house.gd", "res://assets/scripts/construction/buildings/blacksmith_house.gd", "res://assets/scripts/construction/buildings/big_farm_house.gd", "res://assets/scripts/construction/buildings/farmer_house.gd", "res://assets/scripts/farming/plant.gd", "res://assets/scripts/