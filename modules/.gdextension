[configuration]

entry_symbol            = "init_node"
compatibility_minimum   = "4.2"
reloadable              = true

[icons]

FarmingManager = "res://assets/resources/modules/farming.png"
BuildManager = "res://assets/resources/modules/build.png"

[libraries]

macos.debug             = "res://modules/libgdexample.macos.template_debug.framework"
macos.release           = "res://modules/libgdexample.macos.template_release.framework"
windows.debug.x86_32    = "res://modules/libgdexample.windows.template_debug.x86_32.dll"
windows.release.x86_32  = "res://modules/libgdexample.windows.template_release.x86_32.dll"
windows.debug.x86_64    = "res://modules/libgdexample.windows.template_debug.x86_64.dll"
windows.release.x86_64  = "res://modules/libgdexample.windows.template_release.x86_64.dll"
linux.debug.x86_64      = "res://modules/libgdexample.linux.template_debug.x86_64.so"
linux.release.x86_64    = "res://modules/libgdexample.linux.template_release.x86_64.so"
linux.debug.arm64       = "res://modules/libgdexample.linux.template_debug.arm64.so"
linux.release.arm64     = "res://modules/libgdexample.linux.template_release.arm64.so"
linux.debug.rv64        = "res://modules/libgdexample.linux.template_debug.rv64.so"
linux.release.rv64      = "res://modules/libgdexample.linux.template_release.rv64.so"